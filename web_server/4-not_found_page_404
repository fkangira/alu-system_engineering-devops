#!/usr/bin/env bash
# Configure Nginx to display a custom 404 error page.

set -e

apt-get update
apt-get install -y nginx

CONFIG="/etc/nginx/sites-available/default"

mkdir -p /var/www/html
printf "Ceci n'est pas une page\n" > /var/www/html/404.html

if ! grep -q 'error_page 404 /404.html;' "$CONFIG"; then
    sed -i '/location \/ {/i\    error_page 404 /404.html;' "$CONFIG"
fi

if ! grep -q 'location = /404.html' "$CONFIG"; then
    sed -i '/location \/ {/i\    location = /404.html { internal; }' "$CONFIG"
fi

nginx -t
service nginx restart
