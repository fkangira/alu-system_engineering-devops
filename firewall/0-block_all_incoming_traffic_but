#!/usr/bin/env bash
# Block all incoming traffic except TCP ports 22 (SSH), 80 (HTTP) and 443 (HTTPS) with ufw.

apt-get update -y
apt-get install -y ufw

# Allow SSH first so the current session is never locked out.
ufw allow 22/tcp
ufw allow 80/tcp
ufw allow 443/tcp
ufw default deny incoming
ufw default allow outgoing
ufw --force enable
